{
  "name": "skeleton",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "axios-cookiejar-support": "^7.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "pg": "^8.13.0",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "tough-cookie": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  }
}
